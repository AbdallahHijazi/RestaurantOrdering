{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "RestaurantOrdering.Api",
    "Audience": "RestaurantOrdering.Client",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicBasePath": "/uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ]
  },
  "TranslationWorker": {
    "Enabled": false,
    "PollingIntervalSeconds": 10,
    "BatchSize": 10,
    "LeaseDurationSeconds": 120
  },
  "TranslationProvider": {
    "Provider": "NoOp",
    "AzureTranslator": {
      "Endpoint": "https://api.cognitive.microsofttranslator.com",
      "Region": "",
      "TimeoutSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}


